SECRET_KEY=troque-esta-chave
DATABASE_URL=sqlite:///./watch_club.db
# Pasta persistente de uploads (capas, ícones, avatares). Sem este valor, usa app/static/uploads.
# Em produção aponte para um diretório fora do clone da aplicação, por exemplo:
# WATCH_CLUB_UPLOADS_DIR=/caminho/persistente/uploads
APP_BASE_URL=http://127.0.0.1:8000
# false no HTTP local. true em produção quando o site for servido por HTTPS.
SESSION_HTTPS_ONLY=false
EMAIL_DEV_SHOW_LINK=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=watch-club@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Legado: o cadastro público não exige mais convite nem aprovação.
# A variável pode permanecer no .env; o fluxo atual ignora o valor.
# REGISTRATION_INVITE_REQUIRED=false
# Token de leitura da API v3 do TMDB (filmes). Sem este valor, a pesquisa de séries continua.
# TMDB_ACCESS_TOKEN=
# Auth0 (Regular Web Application). Preencha no .env local; nunca versionar o Client Secret.
# AUTH0_DOMAIN=seu-tenant.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# Conexão Database do Auth0 (e-mail/senha). Padrão do tenant:
# AUTH0_CONNECTION=Username-Password-Authentication
# Vitrine visual temporária do fluxo de acesso. Default off. Nunca ligar em produção.
# WATCH_CLUB_UI_PREVIEW=true
